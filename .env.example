# Copy to .env (git-ignored) and fill in. Never commit real keys.

# Stripe TEST secret key: https://dashboard.stripe.com/test/apikeys
# Live keys (sk_live_...) are rejected at startup by design.
STRIPE_SECRET_KEY=

# Optional. Leave empty when using the stripe-cli service in docker-compose:
# it writes the `stripe listen` signing secret to a shared volume automatically.
STRIPE_WEBHOOK_SECRET=

# Where order.paid integration events are POSTed (Make.com / Zapier / n8n webhook URL).
# Empty = the built-in demo sink at /api/dev/webhook-sink.
OUTBOX_WEBHOOK_URL=

# HMAC key for the X-Signature header of outbox webhooks. Use a long random value.
OUTBOX_SIGNING_SECRET=local-demo-signing-secret-change-me
